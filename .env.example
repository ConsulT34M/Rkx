PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# 기본 로컬 주소 외에 허용할 HTTPS 출처를 쉼표로 구분해 지정할 수 있습니다.
APP_ALLOWED_ORIGINS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rkx_app
DB_PASSWORD=change-me
DB_NAME=rkx_consulting
CERN_CAPTCHA_API_URL=
IJINFO_BASE_URL=
IJINFO_API_KEY=
IJINFO_HMAC_SECRET=
# 이용자 휴대폰의 문자 수신함(IJ-info). 비워 두면 IJINFO_BASE_URL 뒤에 /test-inbox/ 를 붙인다.
# 인증번호는 여기로만 간다 — RKX 서버는 인증번호를 받지 않는다.
IJINFO_INBOX_URL=
IJINFO_CALLBACK_SECRET=
# 말결 고객 채팅. MK 서버의 PARTNER_TOKEN 값을 RKX 서버에만 설정합니다.
MK_BASE_URL=
MK_PARTNER_TOKEN=
# 자체 서명 인증서를 쓰는 로컬 MK의 공개 인증서 파일
MK_CA_FILE=
# Docker Desktop에서 호스트의 MK를 쓰면 https://host.docker.internal:8443
MK_DOCKER_BASE_URL=
MK_WEBHOOK_URL=
MK_WEBHOOK_SECRET=
MK_CHAT_WEBHOOK_URL=
MK_PHONE_NUMBER=
RECORDING_RETENTION_DAYS=
