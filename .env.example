PORT=3000
# Docker Compose가 PORT를 여는 호스트 주소. 같은 서버의 프록시만 붙으면 127.0.0.1, 외부에서 직접 받으면 0.0.0.0
BIND_ADDR=127.0.0.1
# 접속 IP를 읽을 때 믿을 리버스 프록시 홉 수. 기본값은 2(현재 배포 구성)이고, 지우거나 비워도 2입니다.
# 프록시가 하나면 1, 프록시 없이 직접 받으면 0. 0이 아닌데 프록시가 없으면 접속 IP를 위조할 수 있습니다.
TRUST_PROXY=2
NODE_ENV=development
# 브라우저가 접속하는 주소. 배포 시 https://<RKX 도메인>
APP_ORIGIN=http://localhost:3000
# 기본 로컬 주소 외에 허용할 HTTPS 출처를 쉼표로 구분해 지정할 수 있습니다.
APP_ALLOWED_ORIGINS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rkx_app
DB_PASSWORD=change-me
DB_NAME=rkx_consulting
CERN_CAPTCHA_API_URL=
IJINFO_BASE_URL=
IJINFO_API_KEY=
IJINFO_HMAC_SECRET=
# 브라우저용 IJ-info 수신함 주소. 로컬 Docker 예: https://localhost:19443/test-inbox/
# 개발 모드의 수신함 화면은 이 출처를 허용한다. 비워 두면 IJINFO_BASE_URL 뒤에 /test-inbox/ 를 붙인다.
IJINFO_INBOX_URL=
IJINFO_CALLBACK_SECRET=
# 말결 고객 채팅. MK 서버의 PARTNER_TOKEN 값을 RKX 서버에만 설정합니다.
MK_BASE_URL=
MK_PARTNER_TOKEN=
# 자체 서명 인증서를 쓰는 로컬 MK의 공개 인증서 파일
MK_CA_FILE=
# Docker Desktop에서 호스트의 MK를 쓰면 https://host.docker.internal:8443
MK_DOCKER_BASE_URL=
MK_WEBHOOK_URL=
MK_WEBHOOK_SECRET=
MK_CHAT_WEBHOOK_URL=
MK_PHONE_NUMBER=
RECORDING_RETENTION_DAYS=
